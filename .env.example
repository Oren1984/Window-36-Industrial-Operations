# Copy to .env to override the local-demo defaults in docker-compose.yml. Never commit .env.
# Database passwords apply when the volume is first created (docker compose down -v to recreate).
W36_DB_OWNER_PASSWORD=change-me-owner
W36_APP_DB_PASSWORD=change-me-app
# Password shared by all demo accounts (planner_fr, approver_fr, viewer, ...)
W36_DEMO_PASSWORD=change-me-demo
# Host port for the UI (bound to 127.0.0.1 only)
W36_UI_PORT=8501
# Demo policy configuration
W36_POLICY_CUSTOMS_ENABLED=false
W36_APPROVER_SPEND_LIMIT_EUR=15000
W36_LOG_LEVEL=INFO
